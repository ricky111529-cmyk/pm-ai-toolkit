# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# AIP API (Miricanvas)
AIP_API_URL=https://<YOUR_API_HOST>/<YOUR_CHAT_ENDPOINT>
AIP_API_DOMAIN=staging
AIP_API_LANGUAGE=ja
AIP_API_COOKIE_NAME=<AUTH_COOKIE_NAME>
AIP_API_COOKIE_VALUE=your_jwt_token_here

# OpenAI API (for future use)
OPENAI_API_KEY=your_openai_api_key_here

# Cache Settings
CACHE_ENABLED=true
CACHE_DIR=./data/cache
CACHE_EXPIRY_HOURS=168

# Token Tracking
TOKEN_TRACKING_ENABLED=true
METRICS_DIR=./data/metrics
